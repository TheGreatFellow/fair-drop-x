# Copy to .env (gitignored) and fill in. Never commit the real .env.

# --- required to deploy ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# Deployer key, 0x-prefixed. Use a throwaway hackathon wallet, not a real one.
PRIVATE_KEY=0x
# Optional, for --verify
ETHERSCAN_API_KEY=

# --- drop roles ---
# Receives the proceeds. Defaults to the deployer.
MAKER_ADDRESS=
# The backend key that signs EIP-712 purchase vouchers. Its private key stays
# server-side only and must never appear in the frontend. Defaults to the deployer.
VERIFIER_ADDRESS=

# --- drop configuration (all optional; defaults are the SPEC §9 demo config) ---
DROP_NAME="Fair Drop Demo"
DROP_SYMBOL=DROP
# Scopes the World ID action and the vouchers to this drop.
DROP_ID=fair-drop/demo-1
SUPPLY=20
# Wei. 0.0002 ether = 200000000000000
BASE_PRICE=200000000000000
# Units sold at BASE_PRICE. Keep this small for the demo so the curve kicks in live.
FLAT_UNITS=3
SLOPE=50000000000000
# Index where the steep final segment starts. Must satisfy FLAT_UNITS < STEEP_START <= SUPPLY.
STEEP_START=18
STEEP_SLOPE=500000000000000
# Sell-back spread in basis points. 500 = 5%, below Mercari's ~10% seller fee.
SPREAD_BPS=500
SALE_DURATION_HOURS=72

# --- World ID (IDKit v4, SPEC §6.2) ---
# All three come from the Developer Portal app: https://developer.worldcoin.org
# Public, safe in the frontend:
WORLD_APP_ID=app_
# Goes in the verify URL path: POST https://developer.world.org/api/v4/verify/{rp_id}
WORLD_RP_ID=rp_
# SECRET. Backend only, used by signRequest() from @worldcoin/idkit-server.
# Never expose to the frontend. Rotate in the Portal if it leaks.
RP_SIGNING_KEY=
# Must match the action created in the Portal, and the DROP_ID above.
WORLD_ACTION=fair-drop-demo-1
# production | staging | sandbox
WORLD_ENVIRONMENT=production
